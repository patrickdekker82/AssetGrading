# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=graadmeter
POSTGRES_USER=graadmeter
POSTGRES_PASSWORD=change-me
WEB_PORT=3000

# Data providers (from phase 1 on). Leave empty until needed.
COINGECKO_API_KEY=
FRED_API_KEY=
TIINGO_API_KEY=
# Optional, paid (EODHD): European stock prices and fundamentals. Leave empty to use free sources.
EODHD_API_KEY=
# Required by SEC: a name and YOUR contact e-mail address.
SEC_USER_AGENT="Graadmeter prive naam@voorbeeld.nl"

# Language model (phase 7). The app works fully without it.
ANTHROPIC_API_KEY=
