# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=graadmeter
POSTGRES_USER=graadmeter
POSTGRES_PASSWORD=change-me
WEB_PORT=3000

# Data providers (from phase 1 on). Leave empty until needed.
COINGECKO_API_KEY=
FRED_API_KEY=
TIINGO_API_KEY=
# Optional, paid (EODHD): European stock prices and fundamentals. Leave empty to use free sources.
EODHD_API_KEY=
# Free (EIA, US Energy Information Administration): weekly oil and gas inventories.
EIA_API_KEY=
# Free (Marketaux, 100 requests a day): news headlines for the quarterly analysis of large misses.
MARKETAUX_API_KEY=
# Required by SEC: a name and YOUR contact e-mail address.
SEC_USER_AGENT="Graadmeter prive naam@voorbeeld.nl"

# Language model (phase 7). The app works fully without it.
ANTHROPIC_API_KEY=

# Login (phase 10). Choose a long password; changing it logs everyone out.
APP_PASSWORD=
# Optional: a separate secret for the session cookie (otherwise derived from APP_PASSWORD).
SESSION_SECRET=

# Notification when a nightly run fails (phase 10). Fill in one or both; leave empty for none.
# Webhook: for example an ntfy topic (https://ntfy.sh/<eigen-geheime-naam>) or a Synology Chat webhook.
NOTIFY_WEBHOOK_URL=
# E-mail over SMTP (for example the mail server of your provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
